# One-shot container that registers every enabled agent (from agents.yaml)
# with the backend once the backend and agents are ready, then exits.
FROM python:3.12-slim

RUN pip install --no-cache-dir requests pyyaml

WORKDIR /app
COPY agents.yaml /app/agents.yaml
COPY register_agents.py /app/register_agents.py

CMD ["python", "register_agents.py"]
