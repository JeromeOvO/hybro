# Configuration for the Hybro default agents.
#
# A single OpenAI API key powers both the backend and these agents.
# Use the SAME key you set in backend/.env.

# Required: OpenAI API key used by every default agent.
OPENAI_API_KEY=

# Required for auto-registration: shared secret the one-shot registrar sends as
# the X-Service-Token header when calling the backend's protected
# /agent/registerAgent endpoint. Set the SAME value as DEFAULT_AGENT_REGISTRAR_TOKEN
# in backend/.env. If unset, registration fails with HTTP 401.
AGENT_REGISTRAR_TOKEN=

# Optional: model used by the weather agent (must support tool calling).
OPENAI_MODEL=gpt-4o-mini

# Optional: model used by the image generator agent.
# gpt-image-1 may require OpenAI org verification; fall back to dall-e-3 if needed.
IMAGE_MODEL=gpt-image-1

# Optional: generated image size.
IMAGE_SIZE=1024x1024
