#!/bin/sh
# The host CLI owns JSON configuration and scoped service/build projections.
set -e
set +x
cd "$(dirname "$0")/.."
REPO_ROOT=$(pwd)
case "${1:-}" in
    help|-h|--help) exec /bin/sh -c 'cat "$1"' sh "$REPO_ROOT/scripts/hybro-help.txt" ;;
    "") if [ ! -t 0 ] || [ ! -t 1 ]; then
            exec /bin/sh -c 'cat "$1"' sh "$REPO_ROOT/scripts/hybro-help.txt"
        fi ;;
esac
if ! command -v uv >/dev/null 2>&1; then
    echo 'Error: hybro requires uv. Install uv, then rerun this command.' >&2
    exit 1
fi
UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT:-${XDG_DATA_HOME:-$HOME/.local/share}/hybro/venv}
export UV_PROJECT_ENVIRONMENT
cd "$REPO_ROOT/backend"
exec uv run --frozen --no-env-file python -m common.config.cli "$@"
