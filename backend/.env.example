# App settings
APP_ENV=development

# Frontend settings
FRONTEND_ORIGINS=http://localhost:3000,https://hybro.ai
API_PREFIX=/api/v1

# MongoDB settings
MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=hybro

# OpenAI settings
OPENAI_API_KEY=
LEAD_AI_MODEL=gpt-5-mini
CLASSIFIER_AI_MODEL=gpt-5-mini
SUPERVISOR_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini settings
GOOGLE_API_KEY=
# Backward-compatible alias. GOOGLE_API_KEY is canonical; GEMINI_API_KEY is
# used only when GOOGLE_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-exp-03-07

# LLM gateway routing and runtime policy
LLM_GATEWAY_MAX_ATTEMPTS=2
LLM_GATEWAY_RETRY_BACKOFF_SECONDS=0.2
LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=60.0
LLM_GATEWAY_STREAM_TIMEOUT_SECONDS=120.0
LLM_GATEWAY_SUPERVISOR_JSON_TIMEOUT_SECONDS=30.0
LLM_GATEWAY_SUPERVISOR_TEXT_TIMEOUT_SECONDS=90.0
LLM_GATEWAY_SUPERVISOR_STREAM_TIMEOUT_SECONDS=90.0
LLM_GATEWAY_DEFAULT_GENERATION_MODEL=lead_ai_model
LLM_GATEWAY_DEFAULT_EMBEDDING_MODEL=embedding_model
LLM_GATEWAY_DEFAULT_SUPERVISOR_MODEL=supervisor_model

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Runtime feature flags
FEATURE_RUN_EVENT_SSE=0
FEATURE_RUN_WATCHDOG=1

# Runtime tuning
SUPERVISOR_MAX_STEPS=8
RUN_WATCHDOG_STALE_MINUTES=90

# Clerk Authentication
CLERK_SECRET_KEY=

#Maximum length of summary
SUMMARY_MAX_WORDS=

#Agent health check interval in seconds
AGENT_HEALTH_CHECK_INTERVAL=3600

# A2A Long-Running Tasks Settings
# Public URL where agents send webhooks (e.g., https://api.example.com)
WEBHOOK_BASE_URL=
# Persistent secret for HMAC token hashing (min 32 bytes). install.sh generates
# an installation-specific value automatically. For manual setup, generate one
# with: openssl rand -hex 32. Keep the same value across restarts and replicas.
WEBHOOK_SIGNING_KEY=
# Max concurrent non-terminal tasks per user (default: 100)
MAX_TASKS_PER_USER=100
# Max concurrent non-terminal tasks per room (default: 50)
MAX_TASKS_PER_ROOM=50
# Poll tasks not updated in this many minutes (default: 10)
STALE_CHECK_MINUTES=10
# Auto-fail tasks older than this many hours (default: 4)
TASK_EXPIRY_HOURS=4
# Warn (log) after this many hours (default: 1)
PENDING_TASK_WARNING_HOURS=1

# Change stream reconnection backoff
CS_BACKOFF_BASE=1.0
CS_BACKOFF_MAX=30.0
CS_BACKOFF_FACTOR=2.0
CS_JITTER_FRACTION=0.25

#Discovery API Key
HYBRO_API_KEY=

# ===========================================
# Context & Memory System Configuration
# See CONTEXT_MEMORY_SYSTEM_DESIGN.md §14.2
# ===========================================

# Token Budget (adjust based on your model)
CONTEXT_MODEL_WINDOW=128000
CONTEXT_SYSTEM_PROMPT_TOKENS=2000
CONTEXT_TOOL_SCHEMA_TOKENS=3000
CONTEXT_RESPONSE_RESERVE_TOKENS=4000
CONTEXT_ROOM_PCT=0.15
CONTEXT_HISTORY_PCT=0.60
CONTEXT_TASK_PCT=0.25

# Compaction Settings (LOSSLESS — stores full content in MongoDB, uses pointers in context)
COMPACTION_ENABLED=true
COMPACTION_MAX_FULL_TURNS=20
COMPACTION_MAX_TOTAL_TOKENS=80000
COMPACTION_PRESERVE_RECENT=10
COMPACTION_CONTENT_TTL_DAYS=0
COMPACTION_CONCURRENCY=5

# Memory Search Settings
MEMORY_SEARCH_ENABLED=true
MEMORY_SEARCH_TEMPORAL_DECAY_ENABLED=true
MEMORY_SEARCH_HALF_LIFE_DAYS=30
MEMORY_SEARCH_MAX_RESULTS=10
MEMORY_SEARCH_MAX_CANDIDATES=1000
MEMORY_SEARCH_MAX_SNIPPET_CHARS=300

# Optional override for durable room file content. By default Hybro uses the
# current user's platform data directory. All application instances sharing one
# MongoDB must mount the same persistent directory at this path.
HYBRO_FILE_DIR=

# A2A inline file dispatch limits
# Max raw bytes for one user-uploaded file inlined into an outbound A2A message.
# Default is 5 MiB. Room attachment uploads are rejected above this limit so
# accepted uploads do not later fail inline agent dispatch for size alone.
A2A_INLINE_FILE_MAX_RAW_BYTES=5242880
# Max aggregate base64-encoded file bytes across all file parts in one outbound A2A message.
# Default matches one 5 MiB raw file after base64 encoding. Set to 0 to derive it from A2A_INLINE_FILE_MAX_RAW_BYTES.
A2A_INLINE_MESSAGE_MAX_ENCODED_BYTES=6990508

# Agent Capability Issue Tracking
# Exclude agents from search after this many open issues (default: 2)
CAPABILITY_ISSUE_THRESHOLD=2

# Gateway base URL
GATEWAY_BASE_URL=http://localhost:8000/api/v1

# Event Broker (cross-instance SSE fan-out + cancellation)
# locally run: redis-server
# docker run -d --name redis-server -p 6379:6379 redis
# then set the REDIS_URL to redis://localhost:6379/0
# Set to enable cross-instance SSE delivery via Redis Pub/Sub (e.g. redis://localhost:6379/0)
# Leave empty to disable (single-instance mode, SSE works as before)
REDIS_URL=

# ===========================================
# Connection Pool Tuning (per-worker)
# ===========================================
# Per-worker MongoDB pool size (total = workers * value)
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=10
# Per-worker Redis connection pool max
# REDIS_MAX_CONNECTIONS=50

# ===========================================
# Multi-Worker Deployment (gunicorn)
# ===========================================
# BREAKING CHANGE: Running under gunicorn now requires Redis.
# The app refuses to start under gunicorn without a connected Redis.
# Previous behavior: missing Redis = "single-instance mode" even under gunicorn.
# For no-Redis single-process mode: uvicorn main:app
