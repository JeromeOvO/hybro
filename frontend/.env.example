NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Server-only backend target used by Next.js rewrites
BACKEND_URL=http://127.0.0.1:8000

# Browser API configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_INSPECTION_TIMEOUT_MS=300000


# E2E test auth (Clerk testing)
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
# Path to an existing room for E2E tests (e.g. /room/abc123)
E2E_TEST_ROOM_PATH=

# Message size validation
NEXT_PUBLIC_MAX_MESSAGE_LENGTH=10000
